<mxGraphModel dx="1400" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1150" math="0" shadow="0" adaptiveColors="auto">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <mxCell id="net" value="Open internet" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fillColor=#e8f4ff;strokeColor=#1f6fb2;" vertex="1" parent="1">
      <mxGeometry x="60" y="40" width="1360" height="140" as="geometry"/>
    </mxCell>
    <mxCell id="rq" value="&lt;b&gt;Requester&lt;/b&gt;&#10;officer at DDC / สคร., ordinary internet connection&#10;unauthenticated, never verified by the system" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1f6fb2;" vertex="1" parent="1">
      <mxGeometry x="110" y="80" width="330" height="80" as="geometry"/>
    </mxCell>
    <mxCell id="rv" value="&lt;b&gt;Reviewer&lt;/b&gt;&#10;named, password + TOTP&#10;no network restriction (may decide from outside DDC)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1f6fb2;" vertex="1" parent="1">
      <mxGeometry x="570" y="80" width="340" height="80" as="geometry"/>
    </mxCell>
    <mxCell id="chk" value="&lt;b&gt;Uptime checker&lt;/b&gt;&#10;DDC infra, reads the /health body&#10;(unauthenticated by design)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1f6fb2;" vertex="1" parent="1">
      <mxGeometry x="1040" y="80" width="330" height="80" as="geometry"/>
    </mxCell>
    <mxCell id="edge" value="Ministry-managed edge — owned by the DDC infra team" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fillColor=#fff4e6;strokeColor=#b26a00;" vertex="1" parent="1">
      <mxGeometry x="60" y="230" width="1360" height="120" as="geometry"/>
    </mxCell>
    <mxCell id="px" value="&lt;b&gt;Public route&lt;/b&gt; — moph.go.th DNS name + ministry-issued TLS certificate&#10;Its timeouts, buffering and body caps are shared ministry policy and are &lt;i&gt;not assumed tunable&lt;/i&gt;.&#10;The design is robust to the worst plausible edge; the largest archive is tens of KB." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b26a00;" vertex="1" parent="1">
      <mxGeometry x="330" y="265" width="820" height="70" as="geometry"/>
    </mxCell>
    <mxCell id="host" value="Single Docker host inside DDC infrastructure — owned by the service owner (everything from the TCP connection inward). Kill switch: docker compose down." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fillColor=#f5f5f5;strokeColor=#333333;" vertex="1" parent="1">
      <mxGeometry x="60" y="400" width="1360" height="500" as="geometry"/>
    </mxCell>
    <mxCell id="app" value="app container — one build, one port, one public route, no CORS" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=2;fillColor=#fffbe6;strokeColor=#d6b656;" vertex="1" parent="1">
      <mxGeometry x="90" y="450" width="450" height="420" as="geometry"/>
    </mxCell>
    <mxCell id="nest" value="&lt;b&gt;NestJS&lt;/b&gt;&#10;/api · /d/&lt;token&gt; · /health&#10;serves the Angular SPA build from the same origin&#10;(static handler excludes the API prefix)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
      <mxGeometry x="115" y="490" width="400" height="100" as="geometry"/>
    </mxCell>
    <mxCell id="wk" value="&lt;b&gt;Extraction worker&lt;/b&gt;&#10;fetch → filter → project → write&#10;global concurrency N = 1 (upstream serializes)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
      <mxGeometry x="115" y="620" width="400" height="90" as="geometry"/>
    </mxCell>
    <mxCell id="tick" value="&lt;b&gt;Scheduler tick&lt;/b&gt; — @nestjs/schedule, every 60 s&#10;one pass, several queries, one Postgres advisory lock&#10;heartbeat row; stale after 5 minutes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
      <mxGeometry x="115" y="740" width="400" height="90" as="geometry"/>
    </mxCell>
    <mxCell id="data" value="host-local services — confirmed unreachable from outside; host-level firewalling required, not just edge routing" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=2;fillColor=#f0fff0;strokeColor=#82b366;" vertex="1" parent="1">
      <mxGeometry x="570" y="450" width="820" height="420" as="geometry"/>
    </mxCell>
    <mxCell id="pg" value="&lt;b&gt;PostgreSQL&lt;/b&gt; — the system of record&#10;Requests, events, sessions, throttle, province table&#10;app role: INSERT/SELECT, &lt;b&gt;DELETE nowhere&lt;/b&gt;&#10;(except the two operational tables)" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
      <mxGeometry x="600" y="490" width="380" height="120" as="geometry"/>
    </mxCell>
    <mxCell id="rd" value="&lt;b&gt;Redis + AOF persistence&lt;/b&gt;&#10;BullMQ executes; Postgres is the truth&#10;the BullMQ job carries a reference only" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
      <mxGeometry x="1000" y="490" width="360" height="120" as="geometry"/>
    </mxCell>
    <mxCell id="mo" value="&lt;b&gt;MinIO&lt;/b&gt; — Extract archives&#10;one object per completed job, single upload&#10;72 h lifecycle rule as a silent backstop only" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
      <mxGeometry x="600" y="640" width="380" height="110" as="geometry"/>
    </mxCell>
    <mxCell id="scr" value="&lt;b&gt;scratch volume&lt;/b&gt;&#10;per-Report-code checkpoints&#10;deleted immediately on upload&#10;job refuses to start below 1 GB free" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=20;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
      <mxGeometry x="1000" y="640" width="360" height="110" as="geometry"/>
    </mxCell>
    <mxCell id="bb" value="&lt;b&gt;Bull Board&lt;/b&gt; — bound to localhost, reached by SSH port-forward. Not on the public ingress and deliberately not behind Reviewer auth: a Reviewer's job is to never see case data. A debugging tool carrying no watcher obligation." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
      <mxGeometry x="600" y="780" width="760" height="70" as="geometry"/>
    </mxCell>
    <mxCell id="ext" value="External services — not administered by this project" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fillColor=#f3e8ff;strokeColor=#7c3aed;" vertex="1" parent="1">
      <mxGeometry x="60" y="950" width="1360" height="150" as="geometry"/>
    </mxCell>
    <mxCell id="up" value="&lt;b&gt;Upstream DDC DDS API&lt;/b&gt;&#10;GET https://exchange.ddc.moph.go.th/api/d506/v1/disease-groups&#10;one bearer token for the whole service · ~3.5 s fixed cost per call&#10;365-day span cap · ~60 s gateway timeout · the failure to fear is revocation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7c3aed;" vertex="1" parent="1">
      <mxGeometry x="110" y="985" width="600" height="100" as="geometry"/>
    </mxCell>
    <mxCell id="smtp" value="&lt;b&gt;SMTP relay&lt;/b&gt; mailrelay.uc-workd.com (STARTTLS on submission)&#10;sends as envocc@ddc.mail.go.th to moph.go.th and external recipients&#10;&lt;b&gt;bounces return to a mailbox this application does not own&lt;/b&gt;&#10;⇒ the system cannot observe whether an email arrived" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7c3aed;" vertex="1" parent="1">
      <mxGeometry x="770" y="985" width="600" height="100" as="geometry"/>
    </mxCell>
