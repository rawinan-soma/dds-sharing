# Every variable the HTTP app reads, validated at boot (NFR-31). Copy to `.env`
# (gitignored) and set real values; Compose reads it from beside
# docker-compose.yml. A missing or malformed value stops the app from booting
# and the error names each variable, never its value.
#
# Only PORT and the two insecure flags have defaults. Everything else is required.
#
# The values below are placeholders that pass validation, so the dev stack starts
# from a straight copy. They are not credentials to deploy with.

# --- app ---------------------------------------------------------------------
# Port the HTTP server listens on. Integer 1-65535. Default 3000.
#PORT=3000
# How many proxy hops to believe for the client IP (duplicate suppression, §4.8):
# `false`, `true`, a hop count, or a comma-separated list of proxy addresses.
TRUST_PROXY=false
# Directory of the built SPA the app serves at `/`. Relative to the working
# directory unless absolute. The image sets it; set it yourself for a bare
# `pnpm start` (e.g. ../web/dist/web/browser).
STATIC_ROOT=../../apps/web/dist/web/browser
# Where the Requester-facing pages are served. An origin only: no path, query or
# trailing slash. https unless ALLOW_INSECURE_TRANSPORT=true.
FRONTEND_URL=https://dds.example.go.th

# --- database ----------------------------------------------------------------
# The owner that migrates. Read by the migration runner and Drizzle Kit, never
# by the HTTP app. postgres:// or postgresql:// URI.
DATABASE_URL=postgres://postgres:change-me@postgres:5432/dds_sharing
# What the app connects as: the read-only login in docker/postgres-init.
APP_DATABASE_URL=postgres://dds_app_login:dds_app@postgres:5432/dds_sharing
# Compose only: the Postgres container's superuser password. Keep it equal to the
# password in DATABASE_URL.
POSTGRES_PASSWORD=change-me

# --- redis -------------------------------------------------------------------
# redis:// or rediss:// URI.
REDIS_URL=redis://redis:6379

# --- minio -------------------------------------------------------------------
# Hostname only: no scheme, no port.
MINIO_ENDPOINT=minio
MINIO_PORT=9000
# Strictly true or false.
MINIO_USE_SSL=false
# Non-empty, no leading or trailing whitespace. Compose also uses these as the
# MinIO container's root user and password.
MINIO_ACCESS_KEY=change-me-access
MINIO_SECRET_KEY=change-me-secret-key
# S3 bucket name: 3-63 characters, lowercase letters, digits and hyphens.
MINIO_BUCKET=dds-sharing

# --- smtp --------------------------------------------------------------------
# Hostname of the mail server (no scheme, no port).
SMTP_HOST=smtp.example.go.th
# Confirm this with the mail operator (OQ-01): there is no default.
SMTP_PORT=587
# Exactly one of SMTP_STARTTLS and SMTP_SECURE should be true. Both true is
# refused. Both false sends mail in plaintext and is refused unless
# SMTP_ALLOW_PLAINTEXT=true. Strictly true or false.
SMTP_STARTTLS=true
SMTP_SECURE=false
# Credentials for the mail server. Non-empty, no leading or trailing whitespace.
SMTP_USER=change-me
SMTP_PASS=change-me
# A bare address, not "Name <address>".
SMTP_FROM=noreply@dds.example.go.th

# --- upstream ----------------------------------------------------------------
# A path prefix is allowed. https unless ALLOW_INSECURE_TRANSPORT=true.
UPSTREAM_BASE_URL=https://exchange.ddc.moph.go.th/api/d506/v1
# The bearer token. Non-empty, no leading or trailing whitespace.
UPSTREAM_TOKEN=change-me

# --- insecure flags (default false; the app logs a WARN and /health reports them) --
# Development only. Accepts http URLs and drops `Secure` from the Reviewer
# cookies. Strictly true or false.
#ALLOW_INSECURE_TRANSPORT=false
# Development only. Allows mail without TLS. Strictly true or false.
#SMTP_ALLOW_PLAINTEXT=false

# --- development harness -------------------------------------------------------
# Read only by the fake upstream (`pnpm --filter api run fake-upstream`).
#FAKE_UPSTREAM_PORT=4010
