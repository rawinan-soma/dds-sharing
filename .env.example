# Copy to .env to override the defaults baked into docker-compose.yml.
# `docker compose up` works from a clean checkout without this file.

POSTGRES_USER=dds
POSTGRES_PASSWORD=dds
POSTGRES_DB=dds_sharing

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

APP_PORT=3000
BASE_URL=http://localhost:3000

DISK_HEALTH_PATH=/
DISK_WARN_PERCENT=75
DISK_UNHEALTHY_PERCENT=90
