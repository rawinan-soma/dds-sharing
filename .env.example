# The environment holds deployment facts, never policy (ADR 0018) — every
# variable below is a fact about *this* deployment: a host, a port, a URL, a
# credential. Copy this file to `.env` (gitignored) and fill in real values;
# `docker compose up` refuses to start with any of the required ones unset.

# --- app ---
# Port the HTTP app listens on. Optional — defaults to 3000.
PORT=3000

# --- db ---
# Migration admin role. Never held by the running app — migration runner,
# Drizzle Kit and host CLI scripts only.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dds_sharing
# Read/write-restricted app_role connection. The only database credential
# the running HTTP app ever holds (spec §12.2).
APP_DATABASE_URL=postgres://app_role:app_role@localhost:5432/dds_sharing

# --- redis ---
REDIS_URL=redis://localhost:6379

# --- minio ---
# Hostname only — no scheme, no port.
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
# Strictly "true" or "false".
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=dds-sharing

# --- smtp ---
SMTP_HOST=localhost
SMTP_PORT=1025
# SMTP_STARTTLS and SMTP_SECURE are strictly "true" or "false", and cannot
# both be true. If both are false, SMTP_ALLOW_PLAINTEXT must be "true".
SMTP_STARTTLS=false
SMTP_SECURE=false
SMTP_USER=smtp-user
SMTP_PASS=smtp-pass
SMTP_FROM=noreply@example.com
# Opt-in for plaintext SMTP (no relay TLS). Defaults to "false".
SMTP_ALLOW_PLAINTEXT=false

# --- upstream ---
UPSTREAM_TOKEN=upstream-bearer-token
# https required unless ALLOW_INSECURE_TRANSPORT=true.
UPSTREAM_BASE_URL=https://upstream.example.com

# --- transport ---
# Origin only — no path, query string or trailing slash. https required
# unless ALLOW_INSECURE_TRANSPORT=true.
FRONTEND_URL=https://app.example.com
# One flag for one fact: this deployment has no TLS. Permits a non-Secure
# session cookie and http for FRONTEND_URL/UPSTREAM_BASE_URL together.
# Defaults to "false" — never enable this in production.
ALLOW_INSECURE_TRANSPORT=false

# --- fake upstream harness (dev only, compose.dev.yml) ---
FAKE_UPSTREAM_PORT=4010
