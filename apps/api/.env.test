# Dummy values for every variable, loaded by Vitest (test/setup-env.ts) for the
# unit and e2e suites. Nothing here is a real credential. Variables already set
# in the environment win, which is how CI points the suite at its own database.
PORT=3000
TRUST_PROXY=false
STATIC_ROOT=test/fixtures/public
FRONTEND_URL=https://frontend.test
SCRATCH_DIR=test/fixtures/scratch
LOG_DIR=test/fixtures/logs
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dds_sharing
APP_DATABASE_URL=postgres://dds_app_login:dds_app@localhost:5432/dds_sharing
REDIS_URL=redis://localhost:6379
MINIO_ENDPOINT=minio.test
MINIO_PORT=9000
MINIO_USE_SSL=true
MINIO_ACCESS_KEY=test-minio-access-key
MINIO_SECRET_KEY=test-minio-secret-key
MINIO_BUCKET=dds-test
SMTP_HOST=smtp.test
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_SECURE=false
SMTP_USER=test-smtp-user
SMTP_PASS=test-smtp-pass
SMTP_FROM=noreply@dds.test
UPSTREAM_BASE_URL=https://upstream.test/api/d506/v1
UPSTREAM_TOKEN=test-upstream-token
FAKE_UPSTREAM_PORT=4010
