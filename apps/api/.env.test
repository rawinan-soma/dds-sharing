# Dummy values for every variable the HTTP app schema validates (ticket
# #85), loaded through Vitest setup for the unit and e2e configs. CI
# overrides only DATABASE_URL and APP_DATABASE_URL with its own service
# container — dotenv never replaces a variable already set in the
# environment, so those two win there and these two are only used locally.
# Every secret below is a sentinel string, never a real credential.

PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dds_sharing
APP_DATABASE_URL=postgres://app_role:app_role@localhost:5432/dds_sharing
REDIS_URL=redis://localhost:6379
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=test-sentinel-minio-access-key
MINIO_SECRET_KEY=test-sentinel-minio-secret-key
MINIO_BUCKET=dds-sharing-test
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_STARTTLS=false
SMTP_SECURE=false
SMTP_USER=test-sentinel-smtp-user
SMTP_PASS=test-sentinel-smtp-pass
SMTP_FROM=test@example.com
SMTP_ALLOW_PLAINTEXT=true
UPSTREAM_TOKEN=test-sentinel-upstream-token
UPSTREAM_BASE_URL=https://upstream.test.invalid
FRONTEND_URL=https://app.test.invalid
ALLOW_INSECURE_TRANSPORT=false
FAKE_UPSTREAM_PORT=4010
