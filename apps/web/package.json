{
  "name": "web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "prebuild": "paraglide-js compile --project ../../project.inlang --outdir ./src/paraglide --silent --emit-ts-declarations",
    "prestart": "paraglide-js compile --project ../../project.inlang --outdir ./src/paraglide --silent --emit-ts-declarations",
    "watch:i18n": "paraglide-js compile --project ../../project.inlang --outdir ./src/paraglide --silent --emit-ts-declarations --watch",
    "dev": "concurrently \"pnpm run watch:i18n\" \"ng serve\"",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "eslint . --fix"
  },
  "private": true,
  "packageManager": "pnpm@10.30.1",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.21",
    "@angular/cli": "^21.2.21",
    "@angular/compiler-cli": "^21.2.0",
    "@inlang/paraglide-js": "^2.25.4",
    "concurrently": "^9.1.2",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
